{
  "name": "iave-clinic-server",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "nodemon",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:migrate": "npx prisma migrate dev",
    "db:generate": "npx prisma generate",
    "db:seed": "npx prisma db seed",
    "db:seed:catalog": "ts-node --project tsconfig.seed.json prisma/seed-catalog.ts",
    "db:verify:catalog": "ts-node --project tsconfig.seed.json prisma/verify-catalog.ts",
    "chat:verify:coverage": "ts-node --project tsconfig.seed.json prisma/verify-chatbot-knowledge.ts",
    "db:seed:memberships": "ts-node --project tsconfig.seed.json prisma/seed-memberships.ts",
    "db:seed:loyalty": "ts-node --project tsconfig.seed.json prisma/seed-loyalty.ts",
    "db:seed:all": "npx prisma db seed && ts-node --project tsconfig.seed.json prisma/seed-catalog.ts && ts-node --project tsconfig.seed.json prisma/seed-memberships.ts && ts-node --project tsconfig.seed.json prisma/seed-loyalty.ts && ts-node --project tsconfig.seed.json prisma/seed-employees.ts && ts-node --project tsconfig.seed.json prisma/seed-service-staff.ts",
    "db:seed:employees": "ts-node --project tsconfig.seed.json prisma/seed-employees.ts",
    "db:seed:service-staff": "ts-node --project tsconfig.seed.json prisma/seed-service-staff.ts",
    "db:fix:service-groups": "ts-node --project tsconfig.seed.json prisma/fix-service-groups.ts",
    "db:fix:user-phones": "ts-node --project tsconfig.seed.json prisma/fix-user-phones.ts",
    "db:studio": "npx prisma studio",
    "db:reset": "npx prisma migrate reset"
  },
  "prisma": {
    "seed": "ts-node --project tsconfig.seed.json prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.0.1",
    "openai": "^4.73.0",
    "winston": "^3.17.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^8.0.1",
    "nodemon": "^3.1.0",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.0",
    "vitest": "^4.1.11"
  }
}
