generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── Users & Auth ────────────────────────────────────────

model users {
  id              Int       @id @default(autoincrement())
  email           String    @unique @db.VarChar(255)
  password_hash   String    @db.VarChar(255)
  auth_version    Int       @default(0)
  role            UserRole  @default(customer)
  status          UserStatus @default(active)
  // Unique across every role so a customer cannot claim a staff member's
  // number. Nullable, so accounts without a phone may still coexist.
  phone           String?   @unique @db.VarChar(20)
  email_verified_at DateTime?
  last_login_at   DateTime?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt
  deleted_at      DateTime?

  customer        customers?
  staff           staff?
  notifications   notifications[]
  sms_logs        sms_logs[]
  chat_sessions   chat_sessions[]
  inventory_movements inventory_movements[] @relation("performed_by_user")
  password_reset  password_reset_requests?

  @@index([role])
  @@index([status])
  @@index([deleted_at])
}

model password_reset_requests {
  id               String   @id @db.VarChar(64)
  user_id          Int      @unique
  otp_hash         String   @db.Char(64)
  expires_at       DateTime
  attempts         Int      @default(0)
  last_sent_at     DateTime @default(now())
  verified_at      DateTime?
  reset_token_hash String?  @unique @db.Char(64)
  consumed_at      DateTime?
  user             users    @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

enum UserRole {
  admin
  staff
  customer
}

enum UserStatus {
  active
  inactive
  suspended
}

// ─── Customers ───────────────────────────────────────────

model customers {
  id            Int     @id @default(autoincrement())
  user_id       Int     @unique
  first_name    String  @db.VarChar(100)
  last_name     String  @db.VarChar(100)
  date_of_birth DateTime?
  gender        Gender?
  address       String? @db.Text
  city          String? @db.VarChar(100)
  state         String? @db.VarChar(100)
  postal_code   String? @db.VarChar(20)
  notes         String? @db.Text
  avatar_url    String? @db.VarChar(500)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  deleted_at    DateTime?

  user           users          @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  appointments   appointments[]
  transactions   transactions[]
  treatment_records treatment_records[]
  service_reviews  service_reviews[]
  memberships    memberships[]

  @@index([last_name, first_name])
}

enum Gender {
  male
  female
  other
  prefer_not_to_say
}

// ─── Staff ───────────────────────────────────────────────

model staff {
  id              Int     @id @default(autoincrement())
  user_id         Int     @unique
  first_name      String  @db.VarChar(100)
  last_name       String  @db.VarChar(100)
  position        StaffPosition @default(aesthetician)
  job_title       String? @db.VarChar(100)
  permission_level String @default("medium") @db.VarChar(20)
  status          StaffStatus   @default(active)
  hire_date       DateTime?
  date_of_birth   DateTime?
  gender          Gender?
  address         String? @db.Text
  avatar_url      String? @db.VarChar(500)
  bio             String? @db.Text
  notes           String? @db.Text
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
  deleted_at      DateTime?

  user                      users                      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  schedules                 staff_schedules[]
  appointments              appointments[]
  transactions              transactions[]
  discounts_applied         transactions[]           @relation("DiscountApplied")
  membership_payments_received membership_payments[]  @relation("MembershipPaymentReceived")
  treatment_records         treatment_records[]
  service_reviews          service_reviews[]
  service_staff             service_staff[]

  @@index([position])
  @@index([status])
  @@index([last_name, first_name])
}

enum StaffPosition {
  doctor
  nurse
  aesthetician
  therapist
  receptionist
  manager
  head_admin
  nail_technician
  facialist
  nail_and_skin_care_specialist
  clinic_head_nurse
}

enum StaffStatus {
  active
  on_leave
  inactive
  terminated
}

// ─── Staff Schedules ─────────────────────────────────────

model staff_schedules {
  id          Int     @id @default(autoincrement())
  staff_id    Int
  day_of_week DayOfWeek
  start_time  String  @db.VarChar(5)  // "09:00"
  end_time    String  @db.VarChar(5)  // "18:00"
  break_start String? @db.VarChar(5)  // "12:00"
  break_end   String? @db.VarChar(5)  // "13:00"
  is_active   Boolean @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  staff staff @relation(fields: [staff_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([staff_id, day_of_week])
  @@index([day_of_week])
}

enum DayOfWeek {
  monday
  tuesday
  wednesday
  thursday
  friday
  saturday
  sunday
}

// ─── Services ────────────────────────────────────────────

model services {
  id               Int     @id @default(autoincrement())
  name             String  @db.VarChar(255)
  description      String? @db.Text
  category         ServiceCategory @default(other)
  category_id      Int?
  service_type     String? @db.VarChar(50)
  pricing_type     String  @default("fixed") @db.VarChar(20)
  price            Decimal @default(0) @db.Decimal(12, 2)
  vip_price        Decimal? @db.Decimal(12, 2)
  non_member_price Decimal? @db.Decimal(12, 2)
  duration_minutes Int     @default(30)
  preparation_time_minutes Int @default(0)
  buffer_time_minutes      Int @default(0)
  cleanup_time_minutes     Int @default(0)
  image_url        String? @db.VarChar(500)
  is_active        Boolean @default(true)
  status           ServiceStatus @default(active)
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt
  deleted_at       DateTime?

  // ── Extended: catalog ──
  group_id            Int?
  slug                String? @unique @db.VarChar(255)
  inclusions          Json?
  is_legacy           Boolean @default(false)
  needs_verification  Boolean @default(false)

  // ── Extended: external catalog provenance (SOURCE B / Doctors-Procedures.xlsx) ──
  external_id         String? @db.VarChar(100)
  sku                 String? @db.VarChar(120)
  treatment_type      String? @db.VarChar(100)
  online_booking      String  @default("Enabled") @db.VarChar(20)
  available_for       String  @default("Everyone") @db.VarChar(30)
  voucher_sales       String  @default("Enabled") @db.VarChar(20)
  commissions         String  @default("Enabled") @db.VarChar(20)

  appointments          appointments[]
  service_staff         service_staff[]
  service_inventory_items service_inventory_items[]
  transaction_items     transaction_items[]
  treatment_records     treatment_records[]
  service_reviews       service_reviews[]
  appointment_services  appointment_services[] @relation("AppointmentServices")
  group                 service_groups? @relation(fields: [group_id], references: [id], onDelete: SetNull, onUpdate: Cascade)
  variants              service_variants[]
  packages              service_packages?
  category_ref          service_categories? @relation(fields: [category_id], references: [id], onDelete: SetNull, onUpdate: Cascade)
  resources             service_resources[]
  addons                service_addons[]

  @@index([category])
  @@index([status])
  @@index([price])
  @@index([group_id])
}

enum ServiceCategory {
  facial
  body
  hair_removal
  skin_rejuvenation
  injection
  laser
  consultation
  package
  signature_facial
  other
}

enum ServiceStatus {
  active
  inactive
  draft
}

// ─── Service Catalog Pricing Enums ──────────────────────

enum UnitBasis {
  session
  per_nail
  full_set
  per_piece
}

enum MembershipVariantCode {
  student
  single
  duo
  family
  add_on
}

// ─── Service ↔ Staff (M2M) ──────────────────────────────

model service_staff {
  id         Int      @id @default(autoincrement())
  service_id Int
  staff_id   Int
  created_at DateTime @default(now())

  service services @relation(fields: [service_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  staff   staff    @relation(fields: [staff_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([service_id, staff_id])
  @@index([staff_id])
}

// ─── Service ↔ Inventory Consumption ────────────────────

model service_inventory_items {
  id                  Int      @id @default(autoincrement())
  service_id          Int
  product_id          Int
  quantity_per_session Decimal @default(1) @db.Decimal(10, 3)
  is_optional         Boolean @default(false)
  notes               String?  @db.VarChar(255)
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  service services @relation(fields: [service_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  product products @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([service_id, product_id])
  @@index([product_id])
}

// ─── Service Groups (PDF sections) ──────────────────────

model service_groups {
  id            Int      @id @default(autoincrement())
  slug          String   @unique @db.VarChar(80)
  name          String   @db.VarChar(150)
  description   String?  @db.Text
  display_order Int      @default(0)
  is_bookable   Boolean  @default(true)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  services services[]

  @@index([display_order])
}

// ─── Service Variants (per-nail, full-set, fill-up) ─────

model service_variants {
  id               Int      @id @default(autoincrement())
  service_id       Int
  variant_key      UnitBasis @default(session)
  label            String   @db.VarChar(150)
  duration_minutes Int?
  display_order    Int      @default(0)
  is_active        Boolean  @default(true)

  service services        @relation(fields: [service_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([service_id, variant_key])
  @@index([service_id])
}

// ─── Service Packages (session bundles) ─────────────────

model service_packages {
  id                Int      @id @default(autoincrement())
  service_id        Int      @unique
  sessions_included Int      @default(7)
  session_price     Decimal  @db.Decimal(12, 2)
  ten_session_price Decimal? @db.Decimal(12, 2)
  inclusions        Json?
  savings_note      String?  @db.VarChar(255)

  service services @relation(fields: [service_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

// ─── Product Categories ──────────────────────────────────

model product_categories {
  id          Int     @id @default(autoincrement())
  name        String  @unique @db.VarChar(150)
  description String? @db.Text
  sort_order  Int     @default(0)
  is_active   Boolean @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  deleted_at  DateTime?

  products products[]

  @@index([is_active])
}

// ─── Products ────────────────────────────────────────────

model products {
  id                 Int        @id @default(autoincrement())
  product_category_id Int?
  name               String     @db.VarChar(255)
  sku                String     @unique @db.VarChar(100)
  description        String?    @db.Text
  purpose            String?    @db.Text
  benefits           String?    @db.Text
  /// Provenance for researched content, per field. Never used at runtime.
  research_sources   Json?
  unit               ProductUnit @default(piece)
  unit_cost          Decimal    @default(0) @db.Decimal(12, 2)
  unit_price         Decimal    @default(0) @db.Decimal(12, 2)
  current_stock      Decimal    @default(0) @db.Decimal(12, 3)
  minimum_stock      Decimal    @default(0) @db.Decimal(12, 3)
  maximum_stock      Decimal?   @db.Decimal(12, 3)
  is_retail          Boolean    @default(true)
  is_consumable      Boolean    @default(true)
  barcode            String?    @db.VarChar(100)
  image_url          String?    @db.VarChar(500)
  status             ProductStatus @default(active)
  created_at         DateTime   @default(now())
  updated_at         DateTime   @updatedAt
  deleted_at         DateTime?

  category               product_categories?       @relation(fields: [product_category_id], references: [id], onDelete: SetNull, onUpdate: Cascade)
  inventory_movements    inventory_movements[]
  transaction_items      transaction_items[]
  service_inventory_items service_inventory_items[]

  @@index([name])
  @@index([status])
  @@index([is_retail])
  @@index([is_consumable])
  @@index([current_stock, minimum_stock])
}

enum ProductUnit {
  piece
  ml
  mg
  unit
  vial
  tablet
  box
  bottle
}

enum ProductStatus {
  active
  inactive
  discontinued
}

// ─── Inventory Movements ─────────────────────────────────

model inventory_movements {
  id                  Int            @id @default(autoincrement())
  product_id          Int
  type                InventoryMovementType
  quantity            Decimal        @db.Decimal(12, 3)
  unit_cost           Decimal?       @db.Decimal(12, 2)
  running_stock_after Decimal        @db.Decimal(12, 3)
  reference_type      String?        @db.VarChar(50)  // "transaction", "appointment", "manual"
  reference_id        Int?
  performed_by        Int?
  notes               String?        @db.Text
  created_at          DateTime       @default(now())
  updated_at          DateTime       @updatedAt

  product      products @relation(fields: [product_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  performed_by_user users? @relation("performed_by_user", fields: [performed_by], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([product_id])
  @@index([type])
  @@index([created_at])
  @@index([reference_type, reference_id])
}

enum InventoryMovementType {
  purchase
  sale
  adjustment
  consumption
  return
  damage
  transfer
  opening_stock
}

// ─── Appointments ────────────────────────────────────────

model appointments {
  id               Int      @id @default(autoincrement())
  customer_id      Int
  staff_id         Int
  service_id       Int
  appointment_date DateTime @db.Date
  start_time       String   @db.VarChar(5)  // "14:00"
  end_time         String   @db.VarChar(5)  // "15:00"
  status           AppointmentStatus @default(pending)
  quoted_price     Decimal? @db.Decimal(12, 2)
  price_type       String? @db.VarChar(20)
  membership_code  String? @db.VarChar(50)
  // Manual staff discount granted at booking time, on top of any membership or
  // monthly-perk discount already applied to the quote. Null means no manual
  // discount. Stored on the appointment (not just the transaction) so a booking
  // saved without payment still remembers the discount, and so the balance due
  // stays correct after services are added and the quote is recomputed.
  discount_pct     Decimal? @db.Decimal(5, 2)
  discount_reason  String?  @db.VarChar(255)
  cancellation_reason String? @db.Text
  reschedule_reason   String? @db.Text
  notes            String?  @db.Text
  reminder_sent    Boolean  @default(false)
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt
  deleted_at       DateTime?

  customer         customers          @relation(fields: [customer_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  staff            staff              @relation(fields: [staff_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  service          services           @relation(fields: [service_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  status_history   appointment_status_history[]
  treatment_record treatment_records?
  service_review   service_reviews?
  transactions     transactions[]
  services         appointment_services[] @relation("AppointmentServices")

  @@index([appointment_date])
  @@index([staff_id, appointment_date])
  @@index([customer_id])
  @@index([status])
  @@index([staff_id, appointment_date, start_time, end_time])
}

// ─── Appointment Services (multi-service bookings) ──────

model appointment_services {
  id               Int     @id @default(autoincrement())
  appointment_id   Int
  service_id       Int
  unit_price       Decimal? @db.Decimal(12, 2)
  duration_minutes Int?

  appointment appointments @relation("AppointmentServices", fields: [appointment_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  service    services      @relation("AppointmentServices", fields: [service_id], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([appointment_id])
  @@index([service_id])
}

enum AppointmentStatus {
  pending
  confirmed
  checked_in
  in_progress
  completed
  cancelled
  no_show
}

// ─── Appointment Status History ──────────────────────────

model appointment_status_history {
  id             Int     @id @default(autoincrement())
  appointment_id Int
  old_status     AppointmentStatus?
  new_status     AppointmentStatus
  changed_by     Int?
  reason         String? @db.Text
  created_at     DateTime @default(now())

  appointment appointments @relation(fields: [appointment_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([appointment_id])
  @@index([created_at])
}

// ─── Treatment Records ───────────────────────────────────

model treatment_records {
  id                   Int     @id @default(autoincrement())
  appointment_id       Int?    @unique
  staff_id             Int?
  customer_id          Int
  service_id           Int?
  treatment_date       DateTime @db.Date
  start_time           String?  @db.VarChar(5)
  end_time             String?  @db.VarChar(5)
  notes                String?  @db.Text
  recommendations      String?  @db.Text
  side_effects         String?  @db.Text
  before_photo         String?  @db.VarChar(500)
  after_photo          String?  @db.VarChar(500)
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt

  appointment appointments? @relation(fields: [appointment_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  staff       staff?        @relation(fields: [staff_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  customer    customers     @relation(fields: [customer_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  service     services?     @relation(fields: [service_id], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([treatment_date])
  @@index([customer_id])
  @@index([staff_id])
}

// ─── Service Reviews ────────────────────────────────────

model service_reviews {
  id            Int      @id @default(autoincrement())
  customer_id   Int
  appointment_id Int     @unique
  service_id    Int
  staff_id      Int?
  rating        Int      // 1 - 5
  feedback      String?  @db.Text
  created_at    DateTime @default(now())

  customer    customers   @relation(fields: [customer_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  appointment appointments @relation(fields: [appointment_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  service     services    @relation(fields: [service_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  staff       staff?      @relation(fields: [staff_id], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([service_id])
  @@index([customer_id])
  @@index([staff_id])
  @@index([rating])
}

// ─── Transactions ────────────────────────────────────────

model transactions {
  id                Int     @id @default(autoincrement())
  transaction_number String @unique @db.VarChar(50)
  customer_id       Int?
  staff_id          Int?
  appointment_id    Int?
  type              TransactionType @default(sale)
  subtotal          Decimal @default(0) @db.Decimal(12, 2)
  discount_amount   Decimal @default(0) @db.Decimal(12, 2)
  discount_pct      Decimal? @db.Decimal(5, 2)
  discount_reason   String? @db.Text
  discount_applied_by Int?
  tax_amount        Decimal @default(0) @db.Decimal(12, 2)
  total_amount      Decimal @default(0) @db.Decimal(12, 2)
  payment_method    PaymentMethod?
  payment_status    PaymentStatus @default(pending)
  paid_at           DateTime?
  notes             String? @db.Text
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt
  deleted_at        DateTime?

  customer          customers?     @relation(fields: [customer_id], references: [id], onDelete: SetNull, onUpdate: Cascade)
  staff             staff?         @relation(fields: [staff_id], references: [id], onDelete: SetNull, onUpdate: Cascade)
  discount_applier  staff?         @relation("DiscountApplied", fields: [discount_applied_by], references: [id], onDelete: SetNull, onUpdate: Cascade)
  appointment       appointments?  @relation(fields: [appointment_id], references: [id], onDelete: SetNull, onUpdate: Cascade)
  items             transaction_items[]

  @@index([customer_id])
  @@index([staff_id])
  @@index([created_at])
  @@index([type])
  @@index([payment_status])
}

enum TransactionType {
  sale
  refund
  adjustment
}

enum PaymentMethod {
  cash
  gcash
  gotyme
  rcbc
  paid_on_us
}

enum PaymentStatus {
  pending
  paid
  partial
  refunded
  voided
}

// ─── Transaction Items ───────────────────────────────────

model transaction_items {
  id             Int     @id @default(autoincrement())
  transaction_id Int
  product_id     Int?
  service_id     Int?
  description    String  @db.VarChar(255)
  quantity       Decimal @default(1) @db.Decimal(10, 3)
  unit_price     Decimal @default(0) @db.Decimal(12, 2)
  price_type     String? @db.VarChar(20)
  discount       Decimal @default(0) @db.Decimal(12, 2)
  tax            Decimal @default(0) @db.Decimal(12, 2)
  line_total     Decimal @default(0) @db.Decimal(12, 2)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  transaction transactions @relation(fields: [transaction_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  product     products?    @relation(fields: [product_id], references: [id], onDelete: SetNull, onUpdate: Cascade)
  service     services?    @relation(fields: [service_id], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([transaction_id])
  @@index([product_id])
  @@index([service_id])
}

// ─── Notifications ───────────────────────────────────────

model notifications {
  id         Int     @id @default(autoincrement())
  user_id    Int
  type       NotificationType
  title      String  @db.VarChar(255)
  message    String  @db.Text
  data       String? @db.Text  // JSON string for related entity info
  status     NotificationStatus @default(unread)
  read_at    DateTime?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user users @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([user_id, status])
  @@index([type])
  @@index([created_at])
}

enum NotificationType {
  appointment_reminder
  appointment_update
  payment
  promotion
  system
  low_stock
}

enum NotificationStatus {
  unread
  read
  archived
}

// ─── SMS Logs ────────────────────────────────────────────

model sms_logs {
  id              Int       @id @default(autoincrement())
  user_id         Int?
  recipient_phone String    @db.VarChar(20)
  message         String    @db.Text
  status          SmsStatus @default(queued)
  external_id     String?   @db.VarChar(100)
  error_message   String?   @db.Text
  sent_at         DateTime?
  delivered_at    DateTime?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  user users? @relation(fields: [user_id], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([user_id])
  @@index([status])
  @@index([created_at])
}

enum SmsStatus {
  queued
  sent
  delivered
  failed
}

// ─── Chat Sessions & Messages ────────────────────────────

model chat_sessions {
  id            Int      @id @default(autoincrement())
  user_id       Int?
  session_token String   @unique @db.VarChar(128)
  status        ChatSessionStatus @default(active)
  started_at    DateTime @default(now())
  ended_at      DateTime?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  user     users?          @relation(fields: [user_id], references: [id], onDelete: SetNull, onUpdate: Cascade)
  messages chat_messages[]

  @@index([user_id])
  @@index([status])
}

enum ChatSessionStatus {
  active
  closed
}

model chat_messages {
  id          Int      @id @default(autoincrement())
  session_id  Int
  sender_type ChatSenderType
  content     String   @db.Text
  metadata    String?  @db.Text  // JSON for intents, entities
  created_at  DateTime @default(now())

  session chat_sessions @relation(fields: [session_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([session_id, created_at])
}

enum ChatSenderType {
  user
  bot
}

// ─── System Settings ─────────────────────────────────────

model system_settings {
  id            Int      @id @default(autoincrement())
  setting_key   String   @unique @db.VarChar(100)
  setting_value String   @db.Text  // JSON
  description   String?  @db.VarChar(500)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
}

// ─── Membership Plans ────────────────────────────────────

model membership_plans {
  id              Int      @id @default(autoincrement())
  name            String   @db.VarChar(255)
  tier            MembershipTier @default(SILVER)
  duration_months Int      @db.Int
  regular_price   Decimal  @db.Decimal(12, 2)
  promo_price     Decimal  @db.Decimal(12, 2)
  discount_pct    Decimal? @db.Decimal(5, 2)
  description     String?  @db.Text
  is_active       Boolean  @default(true)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  // ── Extended: variant system ──
  variant_code               MembershipVariantCode @default(single)
  term_months                Int      @default(6)
  max_persons                Int      @default(1)
  add_on_price               Decimal? @db.Decimal(12, 2)
  advertised_per_day_price   Decimal? @db.Decimal(12, 2)
  computed_per_day_price     Decimal? @db.Decimal(12, 2)
  sort_order                 Int      @default(0)

  memberships           memberships[]
  loyalty_milestones    loyalty_milestones[]
  benefits              membership_benefits[]
  installment_options   membership_installment_options[]

  @@index([is_active])
  @@index([tier])
  @@index([variant_code])
}

enum MembershipTier {
  SILVER
  GOLD
  PLATINUM
  ELITE
}

// ─── Membership Installment Options ──────────────────────

model membership_installment_options {
  id               Int           @id @default(autoincrement())
  plan_id          Int
  down_payment_pct Decimal       @db.Decimal(5, 2)
  months           Int
  payment_method   PaymentMethod @default(cash)
  is_active        Boolean       @default(true)

  plan membership_plans @relation(fields: [plan_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([plan_id, months])
  @@index([plan_id])
}

// ─── Membership Payments ───────────────────────────────────

model membership_payments {
  id               Int           @id @default(autoincrement())
  membership_id    Int
  amount           Decimal       @db.Decimal(12, 2)
  payment_method   PaymentMethod
  payment_type     MembershipPaymentType @default(FULL)
  installment_no   Int?
  notes            String?       @db.Text
  received_by      Int?
  created_at       DateTime      @default(now())

  membership       memberships   @relation(fields: [membership_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  receiver         staff?        @relation("MembershipPaymentReceived", fields: [received_by], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([membership_id])
  @@index([created_at])
}

enum MembershipPaymentType {
  FULL
  DOWN_PAYMENT
  INSTALLMENT
}

// ─── Memberships ─────────────────────────────────────────

model memberships {
  id              Int      @id @default(autoincrement())
  customer_id     Int
  plan_id         Int
  code            String   @unique @db.VarChar(50)
  status          MembershipStatus @default(pending)
  start_date      DateTime @db.Date
  end_date        DateTime @db.Date
  total_spending  Decimal  @default(0) @db.Decimal(12, 2)
  price           Decimal? @db.Decimal(12, 2)
  amount_paid     Decimal  @default(0) @db.Decimal(12, 2)
  balance         Decimal  @default(0) @db.Decimal(12, 2)
  payment_status  PaymentStatus @default(pending)
  down_payment_due_date DateTime? @db.Date
  pay_in_store_requested Boolean @default(false)
  notes           String?  @db.Text
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  customer        customers             @relation(fields: [customer_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  plan            membership_plans      @relation(fields: [plan_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  loyalty_progress loyalty_progress?
  monthly_perks   monthly_perks[]
  gifts           membership_gifts[]
  activity_logs   membership_activity_logs[]
  payments        membership_payments[]

  @@index([customer_id])
  @@index([code])
  @@index([status])
  @@index([end_date])
}

enum MembershipStatus {
  active
  expired
  suspended
  cancelled
  pending
  failed
}

// ─── Membership Benefits ─────────────────────────────────

model membership_benefits {
  id                 Int      @id @default(autoincrement())
  membership_plan_id Int?
  name               String   @db.VarChar(255)
  description        String?  @db.Text
  benefit_type       String?  @db.VarChar(50)
  discount_pct       Decimal? @db.Decimal(5, 2)
  discount_amount    Decimal? @db.Decimal(12, 2)
  fixed_price        Decimal? @db.Decimal(12, 2)
  eligible_categories Json?
  config             Json?
  is_active          Boolean  @default(true)
  sort_order         Int      @default(0)
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  plan membership_plans? @relation(fields: [membership_plan_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([membership_plan_id])
}

// ─── Loyalty Progress ────────────────────────────────────

model loyalty_progress {
  id                Int      @id @default(autoincrement())
  membership_id     Int      @unique
  qualifying_spend  Decimal  @default(0) @db.Decimal(12, 2)
  total_spend       Decimal  @default(0) @db.Decimal(12, 2)
  highest_reward_pct Decimal @default(0) @db.Decimal(5, 2)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  membership memberships @relation(fields: [membership_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

// ─── Loyalty Milestones ──────────────────────────────────

model loyalty_milestones {
  id              Int      @id @default(autoincrement())
  plan_type       LoyaltyPlanType
  spend_threshold Decimal  @db.Decimal(12, 2)
  reward_pct      Decimal  @db.Decimal(5, 2)
  label           String?  @db.VarChar(255)
  is_active       Boolean  @default(true)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  plan membership_plans? @relation(fields: [plan_id], references: [id], onDelete: SetNull, onUpdate: Cascade)
  plan_id Int?

  @@index([plan_type])
  @@index([is_active])
}

enum LoyaltyPlanType {
  SILVER
  GOLD
  PLATINUM
  ELITE
}

// ─── Monthly Perks ───────────────────────────────────────

model monthly_perks {
  id              Int      @id @default(autoincrement())
  membership_id   Int
  year_month      String   @db.VarChar(7)  // "2026-08"
  status          PerkStatus @default(available)
  max_value       Decimal  @default(300) @db.Decimal(12, 2)
  min_spend       Decimal  @default(800) @db.Decimal(12, 2)
  used_at         DateTime?
  transaction_id  Int?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  membership memberships @relation(fields: [membership_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([membership_id, year_month])
  @@index([year_month])
}

enum PerkStatus {
  available
  used
  expired
}

// ─── Membership Gifts ────────────────────────────────────

model membership_gifts {
  id              Int      @id @default(autoincrement())
  membership_id   Int
  nominee_name    String   @db.VarChar(255)
  nominee_email   String?  @db.VarChar(255)
  nominee_phone   String?  @db.VarChar(20)
  status          GiftStatus @default(available)
  approved_by     Int?
  approved_at     DateTime?
  redeemed_at     DateTime?
  notes           String?  @db.Text
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  membership memberships @relation(fields: [membership_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([membership_id])
  @@index([status])
}

enum GiftStatus {
  available
  pending_approval
  approved
  redeemed
}

// ─── Membership Activity Logs ────────────────────────────

model membership_activity_logs {
  id              Int      @id @default(autoincrement())
  membership_id   Int
  action          String   @db.VarChar(100)
  details         String?  @db.Text  // JSON
  performed_by    Int?
  created_at      DateTime @default(now())

  membership memberships @relation(fields: [membership_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([membership_id])
  @@index([created_at])
}

// ─── Service Categories ─────────────────────────────────

model service_categories {
  id          Int     @id @default(autoincrement())
  name        String  @unique @db.VarChar(150)
  description String? @db.Text
  sort_order  Int     @default(0)
  is_active   Boolean @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  services services[]
}

// ─── Resources ──────────────────────────────────────────

model resources {
  id          Int          @id @default(autoincrement())
  name        String       @db.VarChar(150)
  type        ResourceType @default(equipment)
  description String?      @db.Text
  is_active   Boolean      @default(true)
  created_at  DateTime     @default(now())
  updated_at  DateTime     @updatedAt

  service_resources service_resources[]
}

enum ResourceType {
  room
  equipment
  vehicle
  other
}

// ─── Service ↔ Resources Join ───────────────────────────

model service_resources {
  id          Int      @id @default(autoincrement())
  service_id  Int
  resource_id Int
  created_at  DateTime @default(now())

  service  services  @relation(fields: [service_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  resource resources @relation(fields: [resource_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([service_id, resource_id])
  @@index([resource_id])
}

// ─── Service Add-ons ────────────────────────────────────

model service_addons {
  id                          Int      @id @default(autoincrement())
  service_id                  Int
  name                        String   @db.VarChar(255)
  description                 String?  @db.Text
  price                       Decimal  @default(0) @db.Decimal(12, 2)
  additional_duration_minutes Int      @default(0)
  is_active                   Boolean  @default(true)
  created_at                  DateTime @default(now())
  updated_at                  DateTime @updatedAt

  service services @relation(fields: [service_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([service_id])
}
